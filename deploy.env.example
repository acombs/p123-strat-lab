# Deployment target for ./deploy.sh — copy to deploy.env (gitignored) and fill in.
#
#   cp deploy.env.example deploy.env

# Your GCP project id (required). Billing must be enabled on the project.
PROJECT=my-gcp-project

# Who may access the app through IAP (required). One principal, e.g.
#   user:you@example.com   or   group:team@example.com
IAP_MEMBER=user:you@example.com

# ── Optional overrides (defaults shown) ──────────────────────────────────────
# Cloud Run service name (also used to name the Artifact Registry repo,
# runtime service account and Secret Manager secrets).
#SERVICE=p123-strategy-lab
#REGION=us-central1
# GCS bucket holding app state (strategy lists, settings, perturbation history).
#STATE_BUCKET=my-gcp-project-p123-state
#AR_REPO=p123-strategy-lab
#SA_NAME=p123-strategy-lab-sa
