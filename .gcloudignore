# Files excluded from the source upload to Cloud Build (`gcloud builds submit`).
# When this file exists gcloud uses it INSTEAD of deriving one from .gitignore,
# so it must be complete on its own.
.git
.gitignore
.gcloudignore

# Secrets and per-user config — never leave the machine
.env
**/.env
**/.env*.local
deploy.env

# Local/user state and dev artefacts
backend/*.json
!backend/p123_autocomplete.json
backend/*.json.tmp
backend/dump_strategies.py
backend/inspect_strategies.py
backend/scan_ids.py
backend/compare_dumps.py
backend/compare_summary_details.py
backend/get_swagger.py
backend/p123_openapi.txt
data/
scratch/

# Dependencies and build outputs (rebuilt inside the image)
**/node_modules
**/dist
**/.venv
**/__pycache__
**/*.pyc

# Not needed for the build
docs/
.claude/
.github/
**/.DS_Store
