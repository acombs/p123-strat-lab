# Copy to backend/.env (gitignored) and fill in.
#
#   cp backend/.env.example backend/.env
#
# Portfolio123 API credentials — Account Settings → API on portfolio123.com
# (API access is a paid P123 feature). Used locally and by docker-compose;
# deploy.sh copies them into Secret Manager for Cloud Run.
P123_API_ID=your_api_id_here
P123_API_KEY=your_api_key_here

# Optional: comma-separated strategy IDs to pre-populate the strategy list on
# first start (you can also add them in the UI). Find an ID in the P123 URL
# when viewing a strategy: .../app/strategy/edit/XXXXXXX
#P123_STRATEGY_IDS=1234567,7654321

# Optional: directory for local JSON state (defaults to backend/). docker-compose
# sets this to a mounted volume; on Cloud Run GCS_BUCKET is used instead.
#STATE_DIR=

# Enables CORS for the Vite dev server (http://localhost:5173). Local dev only.
ENV=development
